# Copy to .env in the project root and fill in your keys.

# ── Web search (fallback order; at least one recommended) ────────────────────
TAVILY_API_KEY=
SERPAPI_KEY=
WEB_SEARCH_PROVIDERS=tavily,serpapi,duckduckgo
TAVILY_SEARCH_DEPTH=basic          # basic = 1 credit, advanced = 2 credits
PLANNER_MAX_QUERIES=4              # searches per question (each costs a credit)

# ── Academic (optional key raises rate limits) ───────────────────────────────
SEMANTIC_SCHOLAR_KEY=

# ── LLM providers — tried in order; providers without a key are skipped ─────
# With no key at all the platform still works, using extractive answers.
LLM_PROVIDER_ORDER=anthropic,openai,groq,gemini,openrouter,deepseek,ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high              # low | medium | high | xhigh | max
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Vector store: auto = Qdrant server if running, else embedded in ./data ──
QDRANT_MODE=auto
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Session memory: Redis if running, else SQLite in ./data ─────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Local models (CPU-friendly defaults) ─────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DEVICE=cpu               # cpu | cuda | auto
# HF_ENDPOINT=https://hf-mirror.com   # only if huggingface.co is blocked on your network

# ── Credit-exhaustion handling (seconds a failing provider is paused) ───────
QUOTA_COOLDOWN_S=21600
AUTH_COOLDOWN_S=86400
